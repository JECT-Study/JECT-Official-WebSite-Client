{
  "name": "@jects/vrt",
  "version": "0.0.0",
  "description": "Visual regression tests for @jects/jds (BackstopJS)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "sb:build": "npm --workspace @jects/jds run build-storybook -- -o ../vrt/storybook-static",
    "gen": "node scripts/generate-scenarios.mjs",
    "serve": "http-server storybook-static -p 6007 -s",
    "backstop:reference": "docker run --rm --shm-size=1g --add-host=host.docker.internal:host-gateway -e CI -v \"$PWD\":/src backstopjs/backstopjs:6.3.25 reference",
    "backstop:test": "docker run --rm --shm-size=1g --add-host=host.docker.internal:host-gateway -e CI -v \"$PWD\":/src backstopjs/backstopjs:6.3.25 test",
    "backstop:approve": "docker run --rm -v \"$PWD\":/src backstopjs/backstopjs:6.3.25 approve",
    "clean:reference": "rm -rf backstop_data/bitmaps_reference",
    "ref:run": "npm run clean:reference && npm run gen && npm run backstop:reference",
    "test:run": "npm run gen && npm run backstop:test",
    "vrt:reference": "start-server-and-test serve http://localhost:6007 ref:run",
    "vrt:test": "start-server-and-test serve http://localhost:6007 test:run",
    "vrt:approve": "npm run backstop:approve",
    "report:open": "open backstop_data/html_report/index.html",
    "vrt:baseline": "npm run sb:build && npm run vrt:reference",
    "vrt": "npm run sb:build && npm run vrt:test"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "start-server-and-test": "^2.0.10"
  }
}