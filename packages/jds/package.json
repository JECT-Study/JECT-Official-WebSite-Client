{
  "name": "@jects/jds",
  "version": "0.4.0",
  "description": "Ject Design System",
  "author": "Ject Team",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JECT-Study/JECT-Official-WebSite-Client.git",
    "directory": "packages/jds"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "require": "./dist/theme.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsc --noEmit && tsup",
    "lint": "eslint --fix --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_TOKEN",
    "build:tokens": "npx tsx src/tokens/tokensBuilder.ts",
    "clean": "rimraf dist node_modules .turbo storybook-static",
    "build:icons": "svgr src/assets/icons --out-dir src/components/Icon/generated --typescript --ext tsx",
    "type-check": "tsc -b --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ject/eslint-config": "*",
    "@storybook/addon-docs": "^10.1.0",
    "@storybook/addon-onboarding": "^10.1.0",
    "@storybook/react-vite": "^10.1.0",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "chromatic": "^11.25.2",
    "eslint-plugin-storybook": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.1.0",
    "style-dictionary": "^4.3.2",
    "tsup": "^8.5.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.53.2"
  }
}
